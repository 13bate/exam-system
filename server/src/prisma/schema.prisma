// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  password String
}



model User {
  id String @id @default(cuid())

  // Personal information
  photo                  String?
  name                   String
  patronymic             String?
  surname                String
  nameInDativeCase       String?
  surnameInDativeCase    String?
  patronymicInDativeCase String?

  // Passport information
  passportSeries      String
  passportNumber      String   @unique
  departmentCode      String
  passportDateOfIssue DateTime
  dateOfBirth         DateTime
  passportDepartment  String
  citizenship         String?

  // Place of birth
  placeOfBirth       String?
  municipalFormation String?
  populatedArea      String?

  // Place of service
  serviceRegion          String
  serviceLicenseNumber   String?
  serviceDateOfIssue     DateTime?
  serviceExpirationDate  DateTime?
  serviceCategory        String
  certificateNumber      String?
  goType                 String?
  phoneNumber            String
  email                  String

  // Address
  federalSubject String
  city           String
  locality       String
  street         String
  houseNumber    String
  building       String?
  structure      String?
  apartment      String?

  // Relations
  clientTests          ClientTest[]
  protocolParticipants ProtocolParticipant[]
}

model ClientTest {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @default(now())
  exercise1       Boolean?
  exercise2       Boolean?
  exercise3       Boolean?
  result          Boolean?
  typeOfCheck     String
  allowedMistakes Int ?  @default(1)

  // Relations
  user     User          @relation(fields: [userId], references: [id])
  attempt TestAttempt?

  @@index([userId])
}

model TestAttempt {
  id           String   @id @default(cuid())
  clientTestId String   @unique
  startedAt    DateTime @default(now())
  mistakes     Int?       
  passed       Boolean? 
  isFinished   Boolean  @default(false)

  // Relations
  clientTest ClientTest?   @relation(fields: [clientTestId], references: [id])
  answers    TestAnswer[]

  @@index([clientTestId])
}

model TestAnswer {
  id                   String         @id @default(cuid())
  testAttemptId        String
  questionId           String
  questionOptionId     String

  // Relations
  testAttempt          TestAttempt    @relation(fields: [testAttemptId], references: [id])
  question             Question       @relation(fields: [questionId], references: [id])
  questionOption       QuestionOption @relation(fields: [questionOptionId], references:[id])
  // One answer per question within one attempt
  @@unique([testAttemptId, questionId])

  @@index([testAttemptId])
  @@index([questionId])
}

model Question {
  id                  String @id @default(cuid())
  questionText        String
  questionsPoolId     String
  // Relations
  questionsPool       QuestionsPool  @relation(fields: [questionsPoolId], references: [id])
  questionOptions     QuestionOption[]
  testAnswer          TestAnswer[]

}

model QuestionOption {
  id                  String @id @default(cuid())
  text                String 
  isCorrect           Boolean
  questionId          String
  index               Int

  //Relations
  question            Question @relation(fields: [questionId], references: [id])
  TestAnswer          TestAnswer[]
}


model QuestionsPool {
  id                   String @id @default(cuid())

  //Relations
  questions            Question[]
  
}


model Protocol {
  id          String   @id @default(cuid())
  date        DateTime
  typeOfCheck String

  // Relations
  participants ProtocolParticipant[]
}

model ProtocolParticipant {
  id             String   @id @default(cuid())
  protocolId     String
  userId         String
  date           DateTime
  theoryResult   Boolean
  practiceResult Boolean

  // Relations
  protocol Protocol @relation(fields: [protocolId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([protocolId])
  @@index([userId])
}
